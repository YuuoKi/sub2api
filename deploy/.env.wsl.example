# =============================================================================
# Day0 / WSL local stack env template  ->  copy to deploy/.env and fill in.
#   cp deploy/.env.wsl.example deploy/.env
#   docker compose -f deploy/docker-compose.wsl.yml up -d
# Docker Compose auto-loads deploy/.env to interpolate ${VAR} in the compose file.
# NEVER commit the filled-in deploy/.env (it is git-ignored). This template holds
# only variable names + change-me placeholders — no real values.
# =============================================================================

# --- Secrets (REQUIRED — replace every change-me before first boot) ----------
# Postgres password — used by both the app (DATABASE_PASSWORD) and the db service.
POSTGRES_PASSWORD=change-me-db-password
# Redis password — redis runs with --requirepass; the app authenticates with it.
REDIS_PASSWORD=change-me-cache-password
# Initial admin account password (AUTO_SETUP). Change immediately after first login.
ADMIN_PASSWORD=change-me-admin-password

# --- Non-secret overrides (OPTIONAL) -----------------------------------------
# The compose file already bakes Day0 defaults via ${VAR:-default}; uncomment to
# override. Defaults shown match docker-compose.wsl.yml.
# Host interface the app port binds to. Defaults to 127.0.0.1 (loopback only).
# For LAN access set 0.0.0.0 AND run deploy/day0/windows_enable_lan_access.ps1.
# BIND_HOST=127.0.0.1
# POSTGRES_USER=wujie
# POSTGRES_DB=wujie_api
# ADMIN_EMAIL=admin@wujie.local
# SERVER_MODE=release
# TZ=Asia/Shanghai
